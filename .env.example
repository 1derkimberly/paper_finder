# NCBI E-utilities (https://www.ncbi.nlm.nih.gov/account/settings/ 에서 API 키 발급)
NCBI_API_KEY=
NCBI_EMAIL=
# OpenAlex (Phase 3). 키 없이도 동작하지만 같은 IP가 하루 $0.10 무료 한도를 나눠 쓰고,
# 검색이 몰리면 30초씩 기다려야 할 수 있다. 무료 키(하루 $1): https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Claude API (Phase 4): 키워드 확장, 관련성 판정, 한 줄 요약. 키 발급: https://console.anthropic.com/
# 비우면 LLM 기능만 꺼지고 나머지는 그대로 동작한다.
ANTHROPIC_API_KEY=
# 기본 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
CLAUDE_MODEL=
